# HIAI Environment Variables
# Copy this file to .env and fill in your values.
# HIAI reads these variables directly from the environment; it does not automatically load .env files.

# Provider (openrouter or groq) - default: openrouter
HIAI_PROVIDER=openrouter

# OpenRouter API key (required when using OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API key (required when using Groq)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional model override (default depends on provider)
# OpenRouter examples:
# - openrouter/free
# - deepseek/deepseek-chat-v3-0324:free
# - google/gemini-2.5-flash
# Groq examples:
# - llama-3.3-70b-versatile
# - llama-3.1-8b-instant
# - mixtral-8x7b-32768
HIAI_MODEL=openrouter/free

# Optional API base URL override (default depends on provider)
# OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
HIAI_BASE_URL=https://openrouter.ai/api/v1

# Optional terminal settings
# Set NO_COLOR to any value to disable ANSI colors.
NO_COLOR=1

# Optional terminal type.
TERM=xterm-256color
